#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for airflow.here NGINX virtual-host (capWebVd)
#+end_org """

from bisos.b import cs
import collections
import socket

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo
from bisos.banna import tcpPorts as bannaTcpPorts

_serverName = "airflow.here"
_proxyPort = bannaTcpPorts.tcpPortsAssignedList.tcpPortsList['airflow'].portNu
_proxyIp = socket.gethostbyname(_serverName)


def wvdConfigFunc() -> str:
    return f"""\
server {{
    listen 80;
    server_name {_serverName};

    location / {{
        proxy_pass http://{_proxyIp}:{_proxyPort};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }}
}}
"""


capWebVd_seedInfo.setup(
    serverName=_serverName,
    proxyPort=_proxyPort,
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)